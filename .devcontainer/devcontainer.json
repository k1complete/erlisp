{
	"name": "erlisP - Erlang Lisp Interpreter",
	"build": {
		"dockerfile": "Dockerfile",
		"context": "."
	},
	"remoteEnv": {
		"LANG": "C.UTF-8",
		"LC_ALL": "C.UTF-8"
	},
	"onCreateCommand": "apt-get update && apt-get install -y build-essential git curl",
	"updateContentCommand": "rebar3 do clean, update",
	"postCreateCommand": "rebar3 compile && rebar3 eunit",
	"features": {
		"ghcr.io/devcontainers/features/git:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"erlang-ls.erlang-ls",
				"jam1garner.erlang-formatter"
			],
			"settings": {
				"erlang_ls.signatureHelp": true,
				"erlang_ls.hoverProvider": true,
				"erlang_ls.documentSymbolProvider": true
			}
		}
	},
	"forwardPorts": [
		8000
	],
	"portAttributes": {
		"8000": {
			"label": "Application Port",
			"onAutoForward": "notify"
		}
	},
	"mounts": [
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,readonly"
	],
	"remoteUser": "root",
	"userEnvProbe": "loginShell"
}
